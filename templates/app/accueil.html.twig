{% extends 'base.html.twig' %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
    :root {
        --ink: #1B2A4A;
        --ink-soft: #33394A;
        --parchment: #F7F5EF;
        --paper: #FFFFFF;
        --gold: #B8863B;
        --gold-soft: #E8D9BC;
        --line: #E2DED2;
        --success: #3F7859;
        --success-bg: #E7F0EA;
        --danger: #B23A48;
        --danger-bg: #F7E9EA;
        --warn: #A9722D;
        --warn-bg: #F3E7D4;
    }

    * { box-sizing: border-box; }

    body {
        margin: 0;
        background: var(--parchment);
        color: var(--ink-soft);
        font-family: 'Inter', sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .entete {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 40px;
        background: var(--ink);
        color: var(--parchment);
    }

    .marque { display: flex; align-items: center; gap: 12px; }

    .sceau {
        width: 34px; height: 34px;
        border: 1.5px solid var(--gold);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Fraunces', serif;
        font-weight: 600; font-size: 15px;
        color: var(--gold);
        flex-shrink: 0;
    }

    .marque h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 20px; margin: 0; }
    .marque span {
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--gold-soft);
        margin-top: 2px;
    }

    .session-info { display: flex; align-items: center; gap: 16px; font-size: 14px; }
    .session-info strong { color: var(--gold-soft); font-weight: 600; }

    .lien-discret {
        background: none;
        border: 1px solid rgba(247,245,239,0.3);
        color: var(--parchment);
        padding: 7px 14px;
        border-radius: 6px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        cursor: pointer;
    }
    .lien-discret:hover { background: rgba(247,245,239,0.1); border-color: var(--gold); }

    .conteneur { max-width: 860px; margin: 0 auto; padding: 48px 24px 80px; }

    .carte-connexion {
        max-width: 400px;
        margin: 60px auto;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 40px 36px;
        box-shadow: 0 1px 3px rgba(27,42,74,0.06);
    }

    .carte-connexion .eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--gold);
        margin: 0 0 6px;
    }

    .carte-connexion h2 {
        font-family: 'Fraunces', serif;
        font-size: 26px; font-weight: 600;
        margin: 0 0 28px;
        color: var(--ink);
    }

    label {
        display: block; font-size: 12px; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.05em; color: var(--ink-soft); margin-bottom: 6px; opacity: 0.7;
    }

    input[type=email], input[type=password], input[type=text], textarea, select {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid var(--line);
        border-radius: 6px;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        background: var(--parchment);
        color: var(--ink);
        margin-bottom: 20px;
    }
    input:focus, textarea:focus, select:focus { outline: none; border-color: var(--gold); background: var(--paper); }
    textarea { min-height: 80px; resize: vertical; font-family: 'Inter', sans-serif; }

    .bouton {
        display: inline-block;
        background: var(--ink);
        color: var(--parchment);
        border: none;
        padding: 12px 22px;
        border-radius: 6px;
        font-family: 'Inter', sans-serif;
        font-size: 14px; font-weight: 600;
        cursor: pointer;
    }
    .bouton:hover { background: #263A63; }
    .bouton-secondaire { background: transparent; color: var(--ink); border: 1px solid var(--line); }
    .bouton-secondaire:hover { border-color: var(--gold); background: var(--gold-soft); }

    .message-erreur {
        background: var(--danger-bg); color: var(--danger);
        border-radius: 6px; padding: 10px 14px; font-size: 13px;
        margin-top: 16px; display: none;
    }

    .aide-demo {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11.5px; color: var(--ink-soft); opacity: 0.55;
        margin-top: 24px; line-height: 1.6;
        border-top: 1px dashed var(--line); padding-top: 16px;
    }

    .entete-section { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; }
    .entete-section h2 { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; color: var(--ink); margin: 0; }
    .compteur { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--gold); }

    .panneau { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 28px; margin-bottom: 40px; }

    .grille-champs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .grille-champs .pleine-largeur { grid-column: 1 / -1; }

    .carte-cours {
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 18px 20px;
        margin-bottom: 14px;
        background: var(--paper);
    }
    .carte-cours:hover { border-color: var(--gold); }

    .carte-cours-entete { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 8px; }
    .carte-cours h3 { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 600; color: var(--ink); margin: 0; }

    .matricule { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-soft); opacity: 0.5; white-space: nowrap; }

    .badge {
        display: inline-block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em;
        padding: 3px 9px; border-radius: 20px; font-weight: 500;
    }
    .badge-disponible { background: var(--success-bg); color: var(--success); }
    .badge-complet { background: var(--warn-bg); color: var(--warn); }
    .badge-annule { background: var(--danger-bg); color: var(--danger); }

    .carte-cours .enseignant { font-size: 12.5px; color: var(--ink-soft); opacity: 0.7; margin: 0 0 10px; }
    .carte-cours .description { font-size: 14px; line-height: 1.55; color: var(--ink-soft); white-space: pre-wrap; }

    .etat-vide { text-align: center; padding: 40px 20px; color: var(--ink-soft); opacity: 0.55; font-size: 14px; }

    .zone-resultats-brutes {
        background: var(--ink); color: #D7E3F5;
        font-family: 'IBM Plex Mono', monospace; font-size: 12.5px;
        padding: 16px; border-radius: 8px;
        white-space: pre-wrap; word-break: break-word;
        max-height: 300px; overflow-y: auto;
    }

    .barre-recherche { display: flex; gap: 10px; }
    .barre-recherche input { margin-bottom: 0; flex: 1; }

    .actions-carte { display: flex; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); }
    .lien-action { background: none; border: none; font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; cursor: pointer; padding: 4px 0; }
    .lien-action.modifier { color: var(--ink); }
    .lien-action.supprimer { color: var(--danger); }
    .lien-action:hover { text-decoration: underline; }

    .champ-edition { margin-top: 10px; display: none; }
    .champ-edition.actif { display: block; }
</style>
{% endblock %}

{% block body %}
<header class="entete">
    <div class="marque">
        <div class="sceau">CM</div>
        <div>
            <h1>CampusManager</h1>
            <span>Portail etudiant</span>
        </div>
    </div>
    <div class="session-info" id="bloc-session" style="display:none;">
        <span>Connecte : <strong id="email-connecte"></strong></span>
        <button class="lien-discret" onclick="seDeconnecter()">Se deconnecter</button>
    </div>
</header>

<div class="conteneur">

    <div id="zone-connexion">
        <div class="carte-connexion">
            <p class="eyebrow">Acces reserve</p>
            <h2>Connexion</h2>

            <label for="champ-email">Adresse email</label>
            <input type="email" id="champ-email" value="etudiant1@test.com">

            <label for="champ-mdp">Mot de passe</label>
            <input type="password" id="champ-mdp" value="password123">

            <button class="bouton" style="width:100%;" onclick="seConnecter()">Se connecter</button>

            <div class="message-erreur" id="message-connexion"></div>

            <div class="aide-demo">
                Comptes de demonstration —<br>
                etudiant1@test.com / password123<br>
                etudiant2@test.com / password123<br>
                admin@test.com / adminpass123
            </div>
        </div>
    </div>

    <div id="zone-application" style="display:none;">

        <section class="panneau">
            <div class="entete-section"><h2>Nouvelle inscription</h2></div>
            <div class="grille-champs">
                <div class="pleine-largeur">
                    <label for="nouveau-titre">Titre du cours</label>
                    <input type="text" id="nouveau-titre" placeholder="Ex. Algorithmique avancee">
                </div>
                <div class="pleine-largeur">
                    <label for="nouvelle-description">Description</label>
                    <textarea id="nouvelle-description" placeholder="Contenu, objectifs, modalites..."></textarea>
                </div>
            </div>
            <button class="bouton" onclick="creerCours()">Creer l'inscription</button>
        </section>

        <section>
            <div class="entete-section">
                <h2>Mes cours</h2>
                <span class="compteur" id="compteur-cours"></span>
            </div>
            <div id="liste-cours"></div>
        </section>

        <section class="panneau" style="margin-top: 8px;">
            <div class="entete-section"><h2>Recherche</h2></div>
            <div class="barre-recherche">
                <input type="text" id="terme-recherche" placeholder="Titre a rechercher">
                <button class="bouton bouton-secondaire" onclick="rechercherCours()">Rechercher</button>
            </div>
            <div id="resultats-recherche" style="margin-top:16px;"></div>
        </section>

    </div>
</div>

<script>
const BADGES = { disponible: 'badge-disponible', complet: 'badge-complet', annule: 'badge-annule' };

function seConnecter() {
    const email = document.getElementById('champ-email').value;
    const motDePasse = document.getElementById('champ-mdp').value;
    const messageErreur = document.getElementById('message-connexion');
    messageErreur.style.display = 'none';

    fetch('/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, motDePasse })
    })
    .then(r => r.json())
    .then(data => {
        if (data.token) {
            localStorage.setItem('jwt_token', data.token);
            localStorage.setItem('email_connecte', email);
            localStorage.setItem('roles_connecte', JSON.stringify(data.roles || []));

            if ((data.roles || []).includes('ROLE_ADMIN')) {
                window.location.href = '/admin';
                return;
            }
            afficherApplication();
        } else {
            messageErreur.textContent = data.error || 'Connexion impossible.';
            messageErreur.style.display = 'block';
        }
    });
}

function seDeconnecter() {
    localStorage.removeItem('jwt_token');
    localStorage.removeItem('email_connecte');
    localStorage.removeItem('roles_connecte');
    document.getElementById('zone-application').style.display = 'none';
    document.getElementById('bloc-session').style.display = 'none';
    document.getElementById('zone-connexion').style.display = 'block';
}

function afficherApplication() {
    document.getElementById('zone-connexion').style.display = 'none';
    document.getElementById('zone-application').style.display = 'block';
    document.getElementById('bloc-session').style.display = 'flex';
    document.getElementById('email-connecte').textContent = localStorage.getItem('email_connecte');
    chargerCours();
}

function enTeteAuth() {
    return { 'Authorization': 'Bearer ' + localStorage.getItem('jwt_token') };
}

function creerCarteCours(c) {
    const badgeClasse = BADGES[c.statut] || 'badge-disponible';

    const carte = document.createElement('div');
    carte.className = 'carte-cours';

    const enteteCarte = document.createElement('div');
    enteteCarte.className = 'carte-cours-entete';

    const titre = document.createElement('h3');
    titre.textContent = c.titre;

    const matricule = document.createElement('span');
    matricule.className = 'matricule';
    matricule.textContent = '#' + c.id;

    enteteCarte.appendChild(titre);
    enteteCarte.appendChild(matricule);

    const badge = document.createElement('span');
    badge.className = 'badge ' + badgeClasse;
    badge.textContent = c.statut;

    const enseignant = document.createElement('p');
    enseignant.className = 'enseignant';
    enseignant.textContent = c.nomEnseignant || 'Enseignant non renseigne';

    const description = document.createElement('div');
    description.className = 'description';
    description.textContent = c.description || '';

    const actions = document.createElement('div');
    actions.className = 'actions-carte';
    actions.innerHTML = `
        <button class="lien-action modifier" onclick="basculerEdition(${c.id})">Modifier</button>
        <button class="lien-action supprimer" onclick="supprimerCours(${c.id})">Supprimer</button>
    `;

    const edition = document.createElement('div');
    edition.className = 'champ-edition';
    edition.id = 'edition-' + c.id;
    edition.innerHTML = `
        <select id="statut-${c.id}">
            <option value="disponible" ${c.statut === 'disponible' ? 'selected' : ''}>Disponible</option>
            <option value="complet" ${c.statut === 'complet' ? 'selected' : ''}>Complet</option>
            <option value="annule" ${c.statut === 'annule' ? 'selected' : ''}>Annule</option>
        </select>
        <button class="bouton bouton-secondaire" onclick="enregistrerModification(${c.id})">Enregistrer</button>
    `;

    carte.appendChild(enteteCarte);
    carte.appendChild(badge);
    carte.appendChild(enseignant);
    carte.appendChild(description);
    carte.appendChild(actions);
    carte.appendChild(edition);

    return carte;
}

function chargerCours() {
    fetch('/api/cours', { headers: enTeteAuth() })
        .then(r => r.json())
        .then(cours => {
            const conteneur = document.getElementById('liste-cours');
            document.getElementById('compteur-cours').textContent = cours.length + ' inscription(s)';

            conteneur.innerHTML = '';

            if (cours.length === 0) {
                const vide = document.createElement('div');
                vide.className = 'etat-vide';
                vide.textContent = 'Aucune inscription pour le moment.';
                conteneur.appendChild(vide);
                return;
            }

            cours.forEach(c => conteneur.appendChild(creerCarteCours(c)));
        });
}

function basculerEdition(id) {
    document.getElementById('edition-' + id).classList.toggle('actif');
}

function enregistrerModification(id) {
    const statut = document.getElementById('statut-' + id).value;

    fetch('/api/cours/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', ...enTeteAuth() },
        body: JSON.stringify({ statut })
    })
    .then(() => chargerCours());
}

function supprimerCours(id) {
    fetch('/api/cours/' + id, { method: 'DELETE', headers: enTeteAuth() })
        .then(() => chargerCours());
}

function creerCours() {
    const titre = document.getElementById('nouveau-titre').value;
    const description = document.getElementById('nouvelle-description').value;

    if (!titre) return;

    fetch('/api/cours', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...enTeteAuth() },
        body: JSON.stringify({ titre, description })
    })
    .then(r => r.json())
    .then(() => {
        document.getElementById('nouveau-titre').value = '';
        document.getElementById('nouvelle-description').value = '';
        chargerCours();
    });
}

function rechercherCours() {
    const terme = document.getElementById('terme-recherche').value;

    fetch('/api/cours/recherche?query=' + encodeURIComponent(terme), { headers: enTeteAuth() })
        .then(r => r.json())
        .then(resultats => {
            const zone = document.getElementById('resultats-recherche');
            zone.innerHTML = '';
            const pre = document.createElement('div');
            pre.className = 'zone-resultats-brutes';
            pre.textContent = JSON.stringify(resultats, null, 2);
            zone.appendChild(pre);
        });
}

(function initialiser() {
    if (localStorage.getItem('jwt_token')) {
        const rolesStockes = JSON.parse(localStorage.getItem('roles_connecte') || '[]');
        if (rolesStockes.includes('ROLE_ADMIN')) {
            window.location.href = '/admin';
        } else {
            afficherApplication();
        }
    }
})();
</script>
{% endblock %}